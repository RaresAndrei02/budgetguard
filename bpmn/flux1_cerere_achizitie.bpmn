<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Flux1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BudgetGuard build_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Definitions_Flux1">
    <bpmn:participant id="Participant_Vestra" name="Vestra Retail SRL - BudgetGuard (Flux 1: cerere de achizitie)" processRef="Process_Flux1" />
    <bpmn:participant id="Participant_ANAF" name="ANAF - serviciu web TVA v9" />
    <bpmn:participant id="Participant_BNR" name="BNR - curs valutar zilnic" />
    <bpmn:messageFlow id="MsgFlow_Task_ANAF_Participant_ANAF" name="CUI + data" sourceRef="Task_ANAF" targetRef="Participant_ANAF" />
    <bpmn:messageFlow id="MsgFlow_Participant_ANAF_Task_ANAF" name="date firma (found / notFound)" sourceRef="Participant_ANAF" targetRef="Task_ANAF" />
    <bpmn:messageFlow id="MsgFlow_Task_BNR_Participant_BNR" name="GET curs" sourceRef="Task_BNR" targetRef="Participant_BNR" />
    <bpmn:messageFlow id="MsgFlow_Participant_BNR_Task_BNR" name="curs EUR / USD" sourceRef="Participant_BNR" targetRef="Task_BNR" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Flux1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Flux1">
      <bpmn:lane id="Lane_Solicitant" name="Solicitant">
        <bpmn:flowNodeRef>Start_Cerere</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistem" name="Sistem BudgetGuard (Power Automate)">
        <bpmn:flowNodeRef>Task_Inregistrare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ANAF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BNR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerificaBuget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DateValide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StatusInAprobare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_NotifInAprobare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RespinsaValidare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_NotifRespValidare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RespinsaValidare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PesteBuget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeAprobat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StatusAprobata</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AngajeazaBuget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_NotifAprobare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Aprobata</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeRespins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StatusRespinsa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_NotifRespingere</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Respinsa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Manager centru de cost">
        <bpmn:flowNodeRef>User_Aprobare1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Aprobat1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Aprobare1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Controlling" name="Controlling">
        <bpmn:flowNodeRef>User_Aprobare2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Aprobat2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Aprobare2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Financiar" name="Director financiar">
        <bpmn:flowNodeRef>User_Aprobare3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Aprobat3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Aprobare3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CFO" name="CFO">
        <bpmn:flowNodeRef>User_Aprobare4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Aprobat4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Aprobare4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Cerere" name="Cerere trimisa (Microsoft Forms)">
      <bpmn:outgoing>Flow_Start_Cerere_Task_Inregistrare</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Forms" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Inregistrare" name="Inregistreaza cererea (ID PR-..., status Noua)">
      <bpmn:incoming>Flow_Start_Cerere_Task_Inregistrare</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Inregistrare_Task_ANAF</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_Task_Inregistrare_Store_Cereri1"><bpmn:targetRef>Store_Cereri1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ANAF" name="Valideaza furnizorul la ANAF (V1, V2, V2b, W3)">
      <bpmn:incoming>Flow_Task_Inregistrare_Task_ANAF</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ANAF_Task_BNR</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_BNR" name="Curs BNR (rezerva: W4), calculeaza Valoare_RON (V3)">
      <bpmn:incoming>Flow_Task_ANAF_Task_BNR</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_BNR_Task_VerificaBuget</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_VerificaBuget" name="Verifica data si bugetul (V4, V5, W1, W2)">
      <bpmn:incoming>Flow_Task_BNR_Task_VerificaBuget</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_VerificaBuget_Gateway_DateValide</bpmn:outgoing>
      <bpmn:property id="Property_Task_VerificaBuget" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataIn_Store_Bugete1_Task_VerificaBuget"><bpmn:sourceRef>Store_Bugete1</bpmn:sourceRef><bpmn:targetRef>Property_Task_VerificaBuget</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DateValide" name="Date valide?">
      <bpmn:incoming>Flow_Task_VerificaBuget_Gateway_DateValide</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_DateValide_Task_StatusInAprobare</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_DateValide_Task_RespinsaValidare</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_StatusInAprobare" name="Seteaza status 'In aprobare'">
      <bpmn:incoming>Flow_Gateway_DateValide_Task_StatusInAprobare</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_StatusInAprobare_Send_NotifInAprobare</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Send_NotifInAprobare" name="Notifica solicitantul (email + Teams)">
      <bpmn:incoming>Flow_Task_StatusInAprobare_Send_NotifInAprobare</bpmn:incoming>
      <bpmn:outgoing>Flow_Send_NotifInAprobare_User_Aprobare1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_RespinsaValidare" name="Seteaza status 'Respinsa' (motive validare)">
      <bpmn:incoming>Flow_Gateway_DateValide_Task_RespinsaValidare</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RespinsaValidare_Send_NotifRespValidare</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Send_NotifRespValidare" name="Notifica respingerea (email + Teams)">
      <bpmn:incoming>Flow_Task_RespinsaValidare_Send_NotifRespValidare</bpmn:incoming>
      <bpmn:outgoing>Flow_Send_NotifRespValidare_End_RespinsaValidare</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_RespinsaValidare" name="Respinsa la validare">
      <bpmn:incoming>Flow_Send_NotifRespValidare_End_RespinsaValidare</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="User_Aprobare1" name="Aprobare pas 1 - manager CC">
      <bpmn:incoming>Flow_Send_NotifInAprobare_User_Aprobare1</bpmn:incoming>
      <bpmn:outgoing>Flow_User_Aprobare1_Gateway_Aprobat1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Aprobat1" name="Aprobat?">
      <bpmn:incoming>Flow_User_Aprobare1_Gateway_Aprobat1</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Aprobat1_User_Aprobare2</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Aprobat1_Gateway_MergeRespins</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="User_Aprobare2" name="Aprobare pas 2 - controlling">
      <bpmn:incoming>Flow_Gateway_Aprobat1_User_Aprobare2</bpmn:incoming>
      <bpmn:outgoing>Flow_User_Aprobare2_Gateway_Aprobat2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Aprobat2" name="Aprobat?">
      <bpmn:incoming>Flow_User_Aprobare2_Gateway_Aprobat2</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Aprobat2_User_Aprobare3</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Aprobat2_Gateway_MergeRespins</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="User_Aprobare3" name="Aprobare pas 3 - director financiar">
      <bpmn:incoming>Flow_Gateway_Aprobat2_User_Aprobare3</bpmn:incoming>
      <bpmn:outgoing>Flow_User_Aprobare3_Gateway_Aprobat3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Aprobat3" name="Aprobat?">
      <bpmn:incoming>Flow_User_Aprobare3_Gateway_Aprobat3</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Aprobat3_Gateway_PesteBuget</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Aprobat3_Gateway_MergeRespins</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_PesteBuget" name="Peste buget sau &gt; prag CFO?">
      <bpmn:incoming>Flow_Gateway_Aprobat3_Gateway_PesteBuget</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_PesteBuget_User_Aprobare4</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_PesteBuget_Gateway_MergeAprobat</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="User_Aprobare4" name="Aprobare pas 4 - CFO">
      <bpmn:incoming>Flow_Gateway_PesteBuget_User_Aprobare4</bpmn:incoming>
      <bpmn:outgoing>Flow_User_Aprobare4_Gateway_Aprobat4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Aprobat4" name="Aprobat?">
      <bpmn:incoming>Flow_User_Aprobare4_Gateway_Aprobat4</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Aprobat4_Gateway_MergeAprobat</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Aprobat4_Gateway_MergeRespins</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="Timer_Aprobare1" name="7 zile" attachedToRef="User_Aprobare1">
      <bpmn:outgoing>Flow_Timer_Aprobare1_Gateway_MergeRespins</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_Aprobare2" name="7 zile" attachedToRef="User_Aprobare2">
      <bpmn:outgoing>Flow_Timer_Aprobare2_Gateway_MergeRespins</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_2"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_Aprobare3" name="7 zile" attachedToRef="User_Aprobare3">
      <bpmn:outgoing>Flow_Timer_Aprobare3_Gateway_MergeRespins</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_3"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_Aprobare4" name="7 zile" attachedToRef="User_Aprobare4">
      <bpmn:outgoing>Flow_Timer_Aprobare4_Gateway_MergeRespins</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_4"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_MergeAprobat">
      <bpmn:incoming>Flow_Gateway_PesteBuget_Gateway_MergeAprobat</bpmn:incoming>
      <bpmn:incoming>Flow_Gateway_Aprobat4_Gateway_MergeAprobat</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_MergeAprobat_Task_StatusAprobata</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_StatusAprobata" name="Seteaza status 'Aprobata'">
      <bpmn:incoming>Flow_Gateway_MergeAprobat_Task_StatusAprobata</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_StatusAprobata_Task_AngajeazaBuget</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_Task_StatusAprobata_Store_Cereri2"><bpmn:targetRef>Store_Cereri2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AngajeazaBuget" name="Angajeaza suma in buget (Angajat_RON, Ramas_RON)">
      <bpmn:incoming>Flow_Task_StatusAprobata_Task_AngajeazaBuget</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_AngajeazaBuget_Send_NotifAprobare</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_Task_AngajeazaBuget_Store_Bugete2"><bpmn:targetRef>Store_Bugete2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Send_NotifAprobare" name="Notifica aprobarea (email + Teams)">
      <bpmn:incoming>Flow_Task_AngajeazaBuget_Send_NotifAprobare</bpmn:incoming>
      <bpmn:outgoing>Flow_Send_NotifAprobare_End_Aprobata</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Aprobata" name="Cerere aprobata">
      <bpmn:incoming>Flow_Send_NotifAprobare_End_Aprobata</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_MergeRespins">
      <bpmn:incoming>Flow_Gateway_Aprobat1_Gateway_MergeRespins</bpmn:incoming>
      <bpmn:incoming>Flow_Timer_Aprobare1_Gateway_MergeRespins</bpmn:incoming>
      <bpmn:incoming>Flow_Gateway_Aprobat2_Gateway_MergeRespins</bpmn:incoming>
      <bpmn:incoming>Flow_Timer_Aprobare2_Gateway_MergeRespins</bpmn:incoming>
      <bpmn:incoming>Flow_Gateway_Aprobat3_Gateway_MergeRespins</bpmn:incoming>
      <bpmn:incoming>Flow_Timer_Aprobare3_Gateway_MergeRespins</bpmn:incoming>
      <bpmn:incoming>Flow_Gateway_Aprobat4_Gateway_MergeRespins</bpmn:incoming>
      <bpmn:incoming>Flow_Timer_Aprobare4_Gateway_MergeRespins</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_MergeRespins_Task_StatusRespinsa</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_StatusRespinsa" name="Seteaza status 'Respinsa' (motivul aprobatorului)">
      <bpmn:incoming>Flow_Gateway_MergeRespins_Task_StatusRespinsa</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_StatusRespinsa_Send_NotifRespingere</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Send_NotifRespingere" name="Notifica respingerea (email + Teams)">
      <bpmn:incoming>Flow_Task_StatusRespinsa_Send_NotifRespingere</bpmn:incoming>
      <bpmn:outgoing>Flow_Send_NotifRespingere_End_Respinsa</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Respinsa" name="Cerere respinsa">
      <bpmn:incoming>Flow_Send_NotifRespingere_End_Respinsa</bpmn:incoming>
    </bpmn:endEvent>
